{
    "name": "zalgo-promise",
    "version": "3.0.1",
    "description": "A promise that settles synchronously when it can. Then-handlers on an already-settled promise run before the current tick ends, so chains that must stay inside a user gesture or avoid microtask lag in a background window can.",
    "keywords": [
        "promise",
        "synchronous",
        "zalgo",
        "cugel"
    ],
    "homepage": "https://github.com/bluepnume/zalgo-promise#readme",
    "bugs": {
        "url": "https://github.com/bluepnume/zalgo-promise/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bluepnume/zalgo-promise.git"
    },
    "license": "Apache-2.0",
    "author": "Daniel Brain",
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=24"
    },
    "main": "./dist/src/index.js",
    "module": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/src/index.d.ts",
            "import": "./dist/src/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "cugel-scripts build",
        "fix": "cugel-scripts fix --changed",
        "fix:all": "cugel-scripts fix",
        "imports:missing": "cugel-scripts imports:missing --changed",
        "lint": "cugel-scripts lint",
        "test:static": "cugel-scripts static",
        "test:unit": "cugel-scripts test --coverage",
        "test:watch": "cugel-scripts test --watch",
        "test": "npm run test:static && npm run test:unit && npm run build",
        "prepack": "npm run build"
    },
    "devDependencies": {
        "cugel-scripts": "^0.1.0",
        "esbuild": "^0.28.0"
    }
}
